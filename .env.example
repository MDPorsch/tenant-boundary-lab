# Tenant Boundary Lab: example environment (M0: documentation of intended settings only).
# NOTHING here is a secret. Never put a private key, token or real credential in this file.
# Test signing keys are generated in memory per test run and never written to disk.

# Must be exactly "1" for any lab/vulnerable behaviour. Unset or anything else = off.
LAB_MODE=0

# lab | test. "production" must refuse to start with the vulnerable variant (TL-16).
TENANTLAB_ENV=lab

# Any SQLAlchemy URL. Unit/lab runs use SQLite; concurrency tests (M5) need PostgreSQL.
TENANTLAB_DATABASE_URL=sqlite+pysqlite:///./out/lab.sqlite

# Verifier configuration (public material only). The verifier accepts exactly one
# algorithm (EdDSA / Ed25519) and requires iss, aud, sub, jti, iat, nbf, exp.
TENANTLAB_JWT_ISSUER=https://issuer.tenantlab.invalid
TENANTLAB_JWT_AUDIENCE=tenantlab-api
# SPKI PEM of the Ed25519 PUBLIC key, supplied by the harness. No private key setting exists.
TENANTLAB_JWT_PUBLIC_KEY_PEM=
